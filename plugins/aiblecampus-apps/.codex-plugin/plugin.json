{
  "name": "aiblecampus-apps",
  "version": "0.25.9+codex.20260915010000",
  "description": "Validate and manage web applications on AibleCampus Apps. Deploy only when the user explicitly requests deployment.",
  "author": {
    "name": "에이블캠퍼스"
  },
  "homepage": "https://github.com/letsur-dev/aiblecampus-plugins",
  "repository": "https://github.com/letsur-dev/aiblecampus-plugins",
  "keywords": [
    "deployment",
    "apps",
    "web app",
    "hosting",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "apps": {
      "command": "node",
      "args": [
        "dist/mcp.js"
      ],
      "cwd": ".",
      "env_vars": [
        "APPS_API_URL",
        "APPS_TOKEN",
        "APPS_IDENTITY_URL",
        "APPS_DEVICE_CLIENT_ID",
        "APPS_RESOURCE",
        "APPS_CREDENTIAL_FILE",
        "APPS_DEPLOYMENT_ATTEMPT_FILE",
        "APPS_DEVICE_LABEL",
        "APPS_OPEN_BROWSER"
      ]
    }
  },
  "interface": {
    "displayName": "에이블캠퍼스 Apps",
    "shortDescription": "명시적으로 요청한 웹앱 배포를 수행합니다",
    "longDescription": "명시적인 배포 요청이 있을 때 웹사이트나 웹앱을 검증하고 에이블캠퍼스 Apps에 배포합니다. 개발이나 수정만 요청하면 자동으로 배포하지 않습니다. 배포 상태, 로그, 환경변수, 비밀값, PostgreSQL과 파일 Storage도 함께 관리할 수 있습니다.",
    "developerName": "에이블캠퍼스",
    "category": "Developer Tools",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/letsur-dev/aiblecampus-plugins",
    "defaultPrompt": [
      "이 웹앱을 완성해서 배포해줘",
      "현재 프로젝트가 배포 가능한지 확인해줘",
      "배포가 실패한 원인을 찾아서 고쳐줘"
    ],
    "brandColor": "#2563EB",
    "screenshots": []
  }
}
