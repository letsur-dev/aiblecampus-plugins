  "author": {
    "name": "에이블캠퍼스"
  },
  "homepage": "https://github.com/letsur-dev/aiblecampus-plugins",
  "repository": "https://github.com/letsur-dev/aiblecampus-plugins",
  "keywords": [
    "deployment",
    "apps",
    "web app",
    "hosting",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "apps": {
      "command": "node",
      "args": [
        "dist/mcp.js"
      ],
      "cwd": ".",
      "env_vars": [
        "APPS_API_URL",
        "APPS_TOKEN",
        "APPS_IDENTITY_URL",
        "APPS_DEVICE_CLIENT_ID",
        "APPS_RESOURCE",
        "APPS_CREDENTIAL_FILE",
        "APPS_DEPLOYMENT_ATTEMPT_FILE",
        "APPS_DEVICE_LABEL",
        "APPS_OPEN_BROWSER"
      ]
    }
  },
  "interface": {
    "displayName": "에이블캠퍼스 Apps",
    "shortDescription": "AI 기능 구현과 명시적으로 요청한 웹앱 배포",
    "longDescription": "Portal 산출물 AI 환경과 Letsur Gateway로 AI 기능을 구현하고 검증합니다. 명시적인 배포 요청이 있을 때만 Apps에 배포하며 상태, 로그와 설정도 관리합니다.",
    "developerName": "에이블캠퍼스",
    "category": "Developer Tools",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/letsur-dev/aiblecampus-plugins",
    "defaultPrompt": [
      "이 앱에 AI로 요청하고 응답하는 기능 구현해줘",
      "이 웹앱을 완성해서 배포해줘",
      "현재 프로젝트가 배포 가능한지 확인해줘",
      "배포가 실패한 원인을 찾아서 고쳐줘"
    ],
    "brandColor": "#2563EB",
    "screenshots": []
  }
}
