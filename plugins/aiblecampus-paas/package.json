{
  "name": "aiblecampus-paas-plugin",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "description": "에이블캠퍼스 PaaS 배포 클라이언트. Claude Code와 Codex 플러그인으로 설치한다.",
  "scripts": {
    "build": "esbuild mcp/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mcp.js && node -e \"const fs=require('node:fs');const p='dist/mcp.js';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/[ \\\\t]+$/gm,''));\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tar": "^7.5.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
